NODE_ENV=development

# Shared
APP_TIMEZONE=America/Sao_Paulo
LEAD_BATCH_DEFAULT_LIMIT=20
LEAD_BATCH_MAX_LIMIT=20
LEAD_DEFAULT_RUNTIME=05:00
LEAD_GEOGRAPHIC_FOCUS=curitiba-sao-jose-dos-pinhais
MOCK_PROVIDER_ENABLED=true
MOCK_PROVIDER_MODE=fallback
EXTERNAL_PROVIDER_ENABLED=true
LEAD_EXTERNAL_API_PROVIDER_NAME=externalLeadProvider
